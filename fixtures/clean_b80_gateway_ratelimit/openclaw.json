{
  "gateway": {
    "bind": "0.0.0.0:8080",
    "auth": {
      "mode": "token",
      "token": "a-very-long-token-of-32-characters",
      "rateLimit": {
        "maxAttempts": 5,
        "windowSeconds": 60
      }
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "allowlist",
      "groupPolicy": "allowlist"
    }
  },
  "tools": {
    "profile": "minimal",
    "sessions": {
      "visibility": "self"
    }
  },
  "logging": {
    "redactSensitive": "tools"
  },
  "models": {
    "main": {
      "provider": "ollama/llama3"
    }
  },
  "session": {
    "dmScope": "per-peer"
  }
}
