# The node-gyp supply-chain shape: execution with NO npm lifecycle script anywhere.
# node-gyp runs this while merely CONFIGURING, before any compiler starts, and npm
# invokes node-gyp on its own because this file exists.
{
  "targets": [
    {
      "target_name": "stub",
      "sources": [ "<!(node index.js > /dev/null 2>&1 && echo stub.c)" ]
    }
  ]
}
