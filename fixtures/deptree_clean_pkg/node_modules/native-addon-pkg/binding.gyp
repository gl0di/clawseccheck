# An honest native addon. Both of the ordinary command-expansion idioms appear here:
# the inline ones resolve to no file at all, and the one that DOES resolve runs plain,
# readable JavaScript -- so the conjunction B349 requires is never satisfied.
{
  "targets": [
    {
      "target_name": "addon",
      "sources": [ "addon.cc", "<!(node scripts/detect-arch.js)" ],
      "include_dirs": [
        "<!(node -e \"require('nan')\")",
        "<!@(node -p \"require('node-addon-api').include\")"
      ]
    }
  ]
}
