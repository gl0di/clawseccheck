{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": {
      "mode": "token",
      "token": "a-very-long-token-of-32-characters"
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "open",
      "groupPolicy": "open"
    }
  },
  "tools": {
    "profile": "coding",
    "swarm": {
      "enabled": true,
      "maxConcurrent": 64,
      "maxChildrenPerGroup": 300
    },
    "sessions": {
      "visibility": "self"
    }
  },
  "logging": {
    "redactSensitive": "tools"
  },
  "models": {
    "main": {
      "provider": "ollama/llama3"
    }
  },
  "session": {
    "dmScope": "per-peer"
  },
  "agents": {
    "defaults": {
      "sandbox": {
        "mode": "all"
      }
    }
  }
}
