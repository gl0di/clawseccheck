{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": {
      "mode": "trusted-proxy",
      "trustedProxy": {
        "userHeader": "x-forwarded-user"
      }
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "allowlist",
      "groupPolicy": "allowlist"
    }
  },
  "tools": {
    "profile": "minimal",
    "sessions": {
      "visibility": "self"
    }
  },
  "logging": {
    "redactSensitive": "tools"
  },
  "models": {
    "main": {
      "provider": "ollama/llama3"
    }
  },
  "session": {
    "dmScope": "per-peer"
  }
}
