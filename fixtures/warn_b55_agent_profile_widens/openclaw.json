{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": { "mode": "token", "token": "a-very-long-token-of-32-characters" }
  },
  "channels": {
    "telegram": { "dmPolicy": "open", "groupPolicy": "allowlist" }
  },
  "tools": {
    "profile": "minimal"
  },
  "agents": {
    "list": [
      { "id": "worker", "tools": { "profile": "coding" } }
    ]
  },
  "logging": { "redactSensitive": "tools" },
  "models": { "main": { "provider": "ollama/llama3" } }
}
