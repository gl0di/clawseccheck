{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": {
      "mode": "token",
      "token": "a-very-long-token-of-32-characters"
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "open",
      "groupPolicy": "allowlist"
    }
  },
  "logging": {
    "redactSensitive": "tools"
  },
  "models": {
    "main": {
      "provider": "ollama/llama3"
    }
  },
  "tools": {
    "profile": "minimal",
    "alsoAllow": [
      "write"
    ]
  },
  "agents": {
    "entries": {
      "main": {
        "default": true
      },
      "helper": {
        "tools": {
          "alsoAllow": [
            "read"
          ]
        }
      }
    }
  }
}
