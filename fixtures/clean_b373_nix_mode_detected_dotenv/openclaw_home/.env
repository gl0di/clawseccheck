# Global runtime dotenv (~/.openclaw/.env). loadGlobalRuntimeDotEnvFiles admits every
# OPENCLAW_* key here with no entryFilter, unlike the workspace .env. A NixOS module
# generates this deployment shape: OPENCLAW_NIX_MODE=1 implies config-read-only too
# (resolveIsConfigReadOnly, paths-V8kKIUzt.mjs:65-67).
OPENCLAW_NIX_MODE=1
