{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": {
      "mode": "token",
      "token": "a-very-long-token-of-32-characters"
    },
    "nodes": {
      "pairing": {
        "autoApproveCidrs": []
      }
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "allowlist",
      "groupPolicy": "allowlist"
    }
  },
  "tools": {
    "profile": "minimal"
  },
  "models": {
    "main": {
      "provider": "ollama/llama3"
    }
  }
}
