{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": {
      "mode": "token",
      "token": "a-very-long-token-of-32-characters"
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.6.10"
  },
  "tools": {
    "exec": {
      "mode": "ask"
    },
    "sessions": {
      "visibility": "self"
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "allowlist",
      "groupPolicy": "allowlist"
    }
  },
  "logging": {
    "redactSensitive": "tools"
  },
  "models": {
    "main": {
      "provider": "ollama/llama3"
    }
  },
  "session": {
    "dmScope": "per-peer"
  }
}
