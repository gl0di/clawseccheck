{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": { "mode": "token", "token": "a-very-long-token-of-32-characters" }
  },
  "env": { "vars": { "ELEVATED_LEVEL": "full" } },
  "agents": {
    "defaults": { "elevatedDefault": "${ELEVATED_LEVEL}" },
    "list": [
      { "name": "Gary" }
    ]
  },
  "channels": { "telegram": { "dmPolicy": "allowlist", "groupPolicy": "allowlist" } },
  "tools": { "profile": "minimal", "elevated": { "allowFrom": { "telegram": ["*"] } } },
  "logging": { "redactSensitive": "tools" },
  "models": { "main": { "provider": "ollama/llama3" } }
}
