{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": {
      "mode": "token",
      "token": "a-very-long-token-of-32-characters"
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "allowlist",
      "groupPolicy": "allowlist"
    }
  },
  "tools": {
    "profile": "minimal",
    "sessions": {
      "visibility": "self"
    }
  },
  "hooks": {
    "mappings": [
      {
        "id": "webhook-alert",
        "event": "incoming",
        "messageTemplate": "New alert from {{source}}: {{message}} (severity {{severity}})"
      }
    ]
  },
  "logging": {
    "redactSensitive": "tools"
  },
  "models": {
    "main": {
      "provider": "ollama/llama3"
    }
  },
  "session": {
    "dmScope": "per-peer"
  }
}
