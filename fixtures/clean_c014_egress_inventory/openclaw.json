{
  "tools": {
    "allow": [
      "exec",
      "http_post"
    ],
    "exec": {
      "mode": "ask"
    },
    "sessions": {
      "visibility": "self"
    }
  },
  "channels": {
    "slack": {
      "dmPolicy": "allowlist",
      "groupPolicy": "allowlist"
    }
  },
  "mcp": {
    "servers": {
      "localdocs": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "."
        ]
      },
      "remote": {
        "url": "https://mcp.example.com/sse",
        "allowedHosts": [
          "mcp.example.com"
        ]
      }
    }
  },
  "session": {
    "dmScope": "per-peer"
  }
}
