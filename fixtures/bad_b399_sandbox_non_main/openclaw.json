{
  "gateway": {
    "bind": "127.0.0.1:8080",
    "auth": {
      "mode": "token",
      "token": "a-very-long-token-of-32-characters"
    }
  },
  "models": {
    "main": {
      "provider": "ollama/llama3"
    }
  },
  "tools": {
    "profile": "full",
    "openclaw": {
      "autoApproveChanges": true
    }
  },
  "agents": {
    "defaults": {
      "sandbox": {
        "mode": "non-main"
      }
    },
    "entries": {
      "main": {}
    }
  }
}
